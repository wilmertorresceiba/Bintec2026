# Copia este archivo a .env y ajusta los valores (todas las variables llevan el prefijo BINTEC_)
BINTEC_DATABASE_URL=sqlite:///database/bintec.db
BINTEC_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
BINTEC_JWT_ALGORITMO=HS256
BINTEC_JWT_EXPIRACION_MINUTOS=60
BINTEC_CORS_ORIGENES=["http://localhost:4200"]
BINTEC_SEMBRAR_AL_INICIAR=true
# Segundo factor del login
BINTEC_DESAFIO_EXPIRACION_MINUTOS=5
BINTEC_MAX_INTENTOS_FALLIDOS=3
BINTEC_MINUTOS_BLOQUEO=15
BINTEC_CODIGO_SEGURIDAD_DEMO=123456
