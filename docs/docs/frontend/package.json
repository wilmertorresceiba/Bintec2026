{
  "name": "app-base",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json -o ",
    "build": "ng build",
    "start:develop": "ng build --configuration develop",
    "build:stats": "ng build --stats-json",
    "watch": "ng build --watch --configuration development",
    "analyze": "ng build --configuration production --stats-json --output-hashing=none --named-chunks && esbuild-visualizer --metadata dist/app-base/stats.json --template treemap --filename dist/app-base/analyze/index.html && http-server dist/app-base/analyze -o -c-1",
    "analyze:source-map": "ng build --configuration production --source-map && source-map-explorer dist/app-base/**/*.js",
    "test": "ng test --code-coverage",
    "test:ci": "ng test --code-coverage --watch=false --browsers=ChromeHeadless",
    "cypress": "cypress open",
    "cypress:component": "cypress open --component",
    "e2e": "cypress run --e2e",
    "test:component": "cypress run --component --env coverage=true",
    "test:component:watch": "cypress open --component",
    "precombine-reports": "node -e \"const fs=require('fs');const p=require('path');const d='coverage/combined/json';fs.mkdirSync(d,{recursive:true});['coverage/unit/json','.nyc_output'].forEach(s=>{if(fs.existsSync(s)){fs.readdirSync(s).filter(f=>f.endsWith('.json')).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))}})\"",
    "combine-reports": "nyc merge coverage/combined/json coverage/combined/merged.json && nyc report -t coverage/combined --report-dir coverage/combined/html --reporter=html --reporter=lcov",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:ci": "ng lint --max-warnings=0",
    "format:test": "prettier --check \"src/**/*.{ts,html,scss,json,js}\"",
    "format:write": "prettier --write \"src/**/*.{ts,html,scss,json,js}\"",
    "license-checker": "license-checker --json",
    "analyze:deps:all": "madge src/main.ts --extensions ts --ts-config tsconfig.json --image deps/core/_all.png",
    "analyze:deps:core": "madge src/app/core --extensions ts --ts-config tsconfig.json --image deps/core/_core.png",
    "analyze:deps:shared": "madge src/app/shared --extensions ts --ts-config tsconfig.json --image deps/core/_shared.png",
    "analyze:deps:feature": "madge src/app/feature --extensions ts --ts-config tsconfig.json --image deps/core/_feature.png",
    "analyze:deps:layout": "madge src/app/layout --extensions ts --ts-config tsconfig.json --image deps/core/_layout.png",
    "analyze:deps:cycles": "madge src/main.ts --circular --extensions ts --ts-config tsconfig.json",
    "deps:check": "ncu",
    "deps:check:ci": "ncu --errorLevel 2",
    "audit:ci": "audit-ci --moderate"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.16",
    "@angular/common": "^20.3.16",
    "@angular/compiler": "^20.3.16",
    "@angular/core": "^20.3.16",
    "@angular/forms": "^20.3.16",
    "@angular/platform-browser": "^20.3.16",
    "@angular/platform-browser-dynamic": "^20.3.16",
    "@angular/router": "^20.3.16",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.15",
    "@angular/build": "^20.3.14",
    "@angular/cli": "^20.3.14",
    "@angular/compiler-cli": "^20.3.16",
    "@cypress/code-coverage": "^3.14.7",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "19.8.1",
    "audit-ci": "^7.1.0",
    "babel-plugin-istanbul": "^7.0.0",
    "cypress": "^15.9.0",
    "cypress-junit-reporter": "^1.3.1",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.3.0",
    "http-server": "^14.1.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "npm-check-updates": "^19.3.1",
    "nyc": "^17.1.0",
    "prettier": "^3.8.1",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.53.0"
  }
}
